# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/llm_gateway
DATABASE_SYNC_URL=postgresql+psycopg2://gateway:gateway@localhost:5432/llm_gateway

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ───────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATEWAY_SECRET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
ADMIN_API_KEY=admin-secret-change-in-production

# ─── Observability ──────────────────────────────────────────
OTEL_ENDPOINT=http://localhost:4317
OTEL_ENABLED=true
LOG_LEVEL=INFO

# ─── Provider API Keys (all optional — mock works without any) ──
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Cache ──────────────────────────────────────────────────
CACHE_DEFAULT_TTL=3600

# ─── Circuit Breaker ────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60

# ─── Mock Provider (for demos without real API keys) ────────
MOCK_LATENCY_MS=300
MOCK_FAILURE_RATE=0.0
MOCK_FAILURE_TYPE=server_error
